{
  "name": "coffee-review",
  "private": true,
  "version": "0.0.0",
  "description": "個人用咖啡杯測記錄工具 — CoE 風格評分介面",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.worker.json",
    "lint": "npm run lint:js && npm run lint:css",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"**/*.css\"",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply coffee-review --local",
    "db:migrate:remote": "wrangler d1 migrations apply coffee-review --remote",
    "cf-typegen": "wrangler types src/worker/worker-configuration.d.ts --include-runtime=false"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "stylelint": "^16.13.0",
    "stylelint-config-recommended": "^15.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.0"
  },
  "dependencies": {
    "hono": "^4.13.8"
  }
}
